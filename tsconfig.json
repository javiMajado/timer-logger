{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",                 
    "moduleResolution": "NodeNext",       
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,                  
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,   
    "verbatimModuleSyntax": true,     
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}